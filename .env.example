# ==========================================================
# outlaw-events — Environment Variables
# Copy these into Vercel: Project Settings → Environment Variables
# (add each one for Production + Preview + Development)
# Without them the secret gate shows "يتعذر بدء جلسة التحقق".
# ==========================================================

# --- Lovable Cloud / Supabase backend ---
SUPABASE_PROJECT_ID="bfdvofpymydrnhxdbvyw"
SUPABASE_URL="https://c--d0a71582-ba61-4997-b03b-3ba9364341c3-prod.lovable.cloud"
SUPABASE_PUBLISHABLE_KEY="sb_publishable__IP3fTlNx_RSoxHI4_y1dw_OlltsbDT"

# Service role key — server only, bypasses RLS.
# Get it from Lovable Cloud secrets (name: SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Secret gate session (REQUIRED — the gate fails without these) ---
# Any random string of 32+ characters. Must match the values used on Lovable,
# otherwise access tokens minted there won't validate here.
SESSION_SECRET=""
ADMIN_HASH_SALT=""

# --- Client-side (Vite) ---
VITE_SUPABASE_PROJECT_ID="bfdvofpymydrnhxdbvyw"
VITE_SUPABASE_URL="https://c--d0a71582-ba61-4997-b03b-3ba9364341c3-prod.lovable.cloud"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable__IP3fTlNx_RSoxHI4_y1dw_OlltsbDT"
